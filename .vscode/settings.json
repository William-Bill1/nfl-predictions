{
  // Pin the interpreter to the project's Python 3.13 venv. The repo also has a
  // stray `.venv` (Python 3.11) that VS Code otherwise auto-selects, which fails
  // with "SyntaxError: f-string expression part cannot include a backslash"
  // because the code uses 3.12+ (PEP 701) f-strings.
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["${workspaceFolder}"]
}
